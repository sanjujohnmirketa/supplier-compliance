# ── Secrets — never commit ──────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python (engine/) ────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ── Node / Salesforce CLI (salesforce/) ─────────────────────────────────────
node_modules/
.sfdx/
.sf/
.localdevserver/

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Claude Code local cache (can contain secrets via Bash command history) ───
.claude/

# ── Logs / temp ──────────────────────────────────────────────────────────────
*.log
*.tmp

# Checkmarx triage artifacts — kept local, not published.
# These map the app's trust boundaries (exact file:line of every scan finding,
# which paths run in system context, which rely on the portal token) and are
# for the AppExchange security review submission, not the public repo.
docs/scans/checkmarx-*
