# ════════════════════════════════════════════════════════════════════════════
# Supplier Compliance Engine — configuration contract
# Copy to .env and fill in. NOTHING is bundled; each deployment supplies its own.
# ════════════════════════════════════════════════════════════════════════════

# ── Core (required) ──────────────────────────────────────────────────────────
INBOUND_TOKEN=change-me-shared-bearer-token
DB_URL=postgresql://user:pass@localhost:5432/compliance

# ── Embeddings (local = on-prem / air-gapped friendly; no external call) ─────
EMBED_BACKEND=local

# ── Policy corpus version (stamped on every citation for provenance/audit) ───
CORPUS_VERSION=2026.06-automotive-v1

# ── LLM provider — pick ONE per deployment ───────────────────────────────────
#   openai | azure | ollama | vllm | local | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT=60

# OpenAI  (LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Azure OpenAI / OpenAI-compatible proxy  (LLM_PROVIDER=azure — set base url + key)
OPENAI_BASE_URL=
# Anthropic  (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Local OpenAI-compatible servers  (LLM_PROVIDER=ollama|vllm|local — NO key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_BASE_URL=

# ── Screening (optional; demo fallback when unset) ───────────────────────────
OPENSANCTIONS_API_KEY=
