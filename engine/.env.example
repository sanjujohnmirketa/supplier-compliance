# ════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your own values.  .env is gitignored and
# must NEVER be committed.  Nothing here ships in the Docker image — all secrets
# are injected at runtime, so the same image runs on cloud or fully on-prem.
# ════════════════════════════════════════════════════════════════════════════

# ---- Database (must match docker-compose.yml) ----
POSTGRES_USER=compliance
POSTGRES_DB=compliance
POSTGRES_PASSWORD=change-me-local-db-password
DB_URL=postgresql://compliance:change-me-local-db-password@localhost:5432/compliance

# ---- Inbound API auth ----
# Any long random string. Salesforce sends it back as "Authorization: Bearer <token>".
INBOUND_TOKEN=change-me-generate-a-long-random-token

# ---- Embeddings ----
# local = sentence-transformers all-MiniLM-L6-v2 (384 dims, no API key, offline)
EMBED_BACKEND=local

# ---- Optional local SFTP server (legacy intake; ingest_local.py needs no SFTP) ----
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USER=compliance
SFTP_PASS=change-me-local-sftp-password
SFTP_DIR=/upload

# ---- LLM provider (pick ONE block; provider-agnostic via llm.py) ----
# OpenAI (default):
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0
LLM_TIMEOUT=45
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=

# Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Fully on-prem / air-gapped (no external key) — Ollama or vLLM (OpenAI-compatible):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ---- Screening providers ----
# Sanctions defaults to the FREE, zero-auth sanctions.network (OFAC/UN/EU).
# Set OPENSANCTIONS_API_KEY only if you have a paid OpenSanctions plan.
OPENSANCTIONS_API_KEY=
# Free Trade.gov Consolidated Screening List key (api.data.gov). Empty → manual.
CSL_API_KEY=
