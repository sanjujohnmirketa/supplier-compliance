        <value xsi:type="xsd:string">iatf_database_number</value>
    </values>
    <values>
        <field>API_Endpoint_Template__c</field>
        <value xsi:type="xsd:string">https://back.iatf-customerportal.org/portal/certificate/{cert_number}</value>
    </values>
    <values>
        <field>API_Result_Mapping__c</field>
        <value xsi:type="xsd:string">{&quot;status_field&quot;:&quot;certStateName&quot;,&quot;name_field&quot;:&quot;name&quot;,&quot;country_field&quot;:&quot;country&quot;,&quot;cert_number_field&quot;:&quot;certNo&quot;,&quot;unique_site_id_field&quot;:&quot;unique_site_id&quot;}</value>
    </values>
    <values>
        <field>API_Valid_States__c</field>
