<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <customPermissions>
        <enabled>true</enabled>
        <name>Grant_Analyst_Workspace</name>
    </customPermissions>
    <description>Analyst workspace: Analyst Console, Accounts, Audit Log — the analyst&apos;s own queue handed off for risk analysis and decision. Includes Grant_Analyst_Workspace custom permission. Assign to Analyst users, not Procurement.</description>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Assessment__c.Analyst_Comment__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Assessment__c.Analyst_Validated__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Multi-document-per-requirement (Compliance_Document_Link__c) — the
         Analyst Console needs to read each linked document's own AI summary
         to render per-file detail. Explicit grant: this org requires it
         beyond what admin testing reveals (see the classAccesses note on
         Procurement_Workspace_Access for the confirmed live precedent). -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.AI_Confidence__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Evaluation_DateTime__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Reason_Code__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Reason_Detail__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Severity__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Valid_Until__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Analyst Workspace Access</label>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Compliance_Document_Link__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <!-- Compliance_Document_Link__c is a MasterDetail child of
         Compliance_Assessment__c — Salesforce requires the parent's Read
         permission explicit in the SAME permission set for the child's Read
         to deploy, regardless of what the Profile already grants. Same for
         Account below it (Compliance_Assessment__c.Supplier__c) — once one
         link in the lookup chain is made explicit, every link above it must
         be too. -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Compliance_Assessment__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <tabSettings>
        <tab>Analyst_Console</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Audit_Log__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Intelligence_Dashboard</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>standard-Account</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
