<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Custom metadata the consoles read (checklist requirement labels, the
         material-type and compliance-domain catalogs). Apex guards those reads
         with Schema.sObjectType.X__mdt.isAccessible(), which reflects THIS
         grant — a non-admin user without it fails the guard (confirmed by
         CrudEnforcementTest running as a Standard User). -->
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Compliance_Domain__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Compliance_Requirement__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Material_Type__mdt</name>
    </customMetadataTypeAccesses>
    <customPermissions>
        <enabled>true</enabled>
        <name>Grant_Analyst_Workspace</name>
    </customPermissions>
    <description>Analyst workspace: Analyst Console, Accounts, Audit Log — the analyst&apos;s own queue handed off for risk analysis and decision. Includes Grant_Analyst_Workspace custom permission. Assign to Analyst users, not Procurement.</description>
    <!-- Compliance_Assessment__c.Analyst_Comment__c / Analyst_Validated__c
         field grants intentionally NOT packaged — see the objectPermissions
         removal note below this block for the full reason (Compliance_
         Assessment__c is Master-Detail to the STANDARD Account object,
         which 2GP package version validation forbids any PermissionSet
         from granting permissions on). Required as a post-install manual
         step via subscriber Profile. -->
    <!-- Multi-document-per-requirement (Compliance_Document_Link__c) — the
         Analyst Console needs to read each linked document's own AI summary
         to render per-file detail. Explicit grant: this org requires it
         beyond what admin testing reveals (see the classAccesses note on
         Procurement_Workspace_Access for the confirmed live precedent). -->
    <!-- Field-level security for every packaged custom field (generated from
         objects/*/fields; master-detail and required fields excluded — those
         carry no FLS). Required because Apex now enforces CRUD/FLS
         (Security.stripInaccessible / WITH USER_MODE): a subscriber user holding
         only this permission set must be able to read and write the fields the
         consoles use. Read+edit on all fields mirrors the access these personas
         effectively had before enforcement; least-privilege per persona is a
         follow-up. -->
