<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <customPermissions>
        <enabled>true</enabled>
        <name>Grant_Analyst_Workspace</name>
    </customPermissions>
    <description>Analyst workspace: Analyst Console, Accounts, Audit Log — the analyst&apos;s own queue handed off for risk analysis and decision. Includes Grant_Analyst_Workspace custom permission. Assign to Analyst users, not Procurement.</description>
    <!-- Compliance_Assessment__c.Analyst_Comment__c / Analyst_Validated__c
         field grants intentionally NOT packaged — see the objectPermissions
         removal note below this block for the full reason (Compliance_
         Assessment__c is Master-Detail to the STANDARD Account object,
         which 2GP package version validation forbids any PermissionSet
         from granting permissions on). Required as a post-install manual
         step via subscriber Profile. -->
    <!-- Multi-document-per-requirement (Compliance_Document_Link__c) — the
         Analyst Console needs to read each linked document's own AI summary
         to render per-file detail. Explicit grant: this org requires it
         beyond what admin testing reveals (see the classAccesses note on
         Procurement_Workspace_Access for the confirmed live precedent). -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.AI_Confidence__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Evaluation_DateTime__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Reason_Code__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Reason_Detail__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Severity__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Valid_Until__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Analyst Workspace Access</label>
    <!-- Compliance_Document_Link__c objectPermissions block also removed —
         its own Read permission depends on Compliance_Assessment__c's Read
         (confirmed via dry-run: "Permission Read Compliance_Document_Link__c
         depends on permission(s): Read Compliance_Assessment__c"), which is
         the exact standard-object-M-D grant this file can no longer
         package. Field-level grants below are left in place; if they also
         turn out to require the object-level grant, the fallback is
         removing this permission set's Compliance_Document_Link__c field
         grants too and covering all of it via post-install Profile setup. -->
    <!-- Compliance_Assessment__c and Account objectPermissions blocks
         intentionally NOT packaged — Compliance_Assessment__c is
         Master-Detail to the STANDARD Account object; 2GP package version
         validation rejects the whole package if any PermissionSet grants
         object/field permissions on a custom object that has a
         Master-Detail relationship to a standard object (confirmed error:
         "references Compliance Assessment that has M-D relationship with
         Account"). This is a hard platform packaging rule, not a bug we
         can work around — per Salesforce, standard-object-adjacent access
         like this must come from the subscriber's Profile, not a packaged
         PermissionSet. Required as a documented post-install manual step.
         (The comment this replaces described an EARLIER, narrower
         understanding — that only the parent-read grant needed to be
         explicit for the child's own grant to deploy — which was correct
         for ordinary incremental deploys but is superseded by this
         stricter 2GP-specific constraint.) -->
    <tabSettings>
        <tab>Analyst_Console</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Audit_Log__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Intelligence_Dashboard</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>standard-Account</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
