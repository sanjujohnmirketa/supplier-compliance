    <label>Analyst Workspace Access</label>
    <!-- Object-level CRUD the Apex now enforces (Security.stripInaccessible /
         WITH USER_MODE). Account: analysts update case-state fields on the
         supplier (assignToAnalyst, sendCaseBackToProcurement, close/review
         outcome) — Edit, not Create/Delete, no View All (queue visibility
         comes from the controllers' deliberate without-sharing reads, not
         from org-wide access). Audit_Log__c: Read only — every audit row is
         written through AuditLogService in system context, so no persona
         ever needs Create/Edit/Delete on it (see that class's header). -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
