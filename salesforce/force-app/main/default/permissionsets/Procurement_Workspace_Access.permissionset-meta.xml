<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Explicit Apex class access — confirmed missing live (2026-08-13):
         a non-admin Procurement user got "You do not have access to the
         Apex class named 'PolicyDocumentController'" even with full object/
         field permissions on Policy_Document__c, because THIS org requires
         explicit classAccesses grants (System Administrator profiles bypass
         this check, which is why it went unnoticed testing as admin). All
         four classes the Procurement workspace's LWCs actually call. -->
    <classAccesses>
        <apexClass>PolicyDocumentController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DocumentProcessingController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>MaterialTypeController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>VendorPortalController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customPermissions>
        <enabled>true</enabled>
        <name>Grant_Procurement_Workspace</name>
    </customPermissions>
    <description>Procurement Manager workspace: Compliance Console (VERA), Policy Documents, Accounts, Audit Log. Includes Grant_Procurement_Workspace custom permission. Assign to Procurement users, not Analysts.</description>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Assessment__c.Analyst_Comment__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Assessment__c.Analyst_Validated__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Policy_Document__c.Chunk_Count__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Policy_Document__c.Corpus_Version__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Policy_Document__c.Domain__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Policy_Document__c.Failure_Reason__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Policy_Document__c.Ingested_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Policy_Document__c.Source_File__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Policy_Document__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Multi-document-per-requirement (Compliance_Document_Link__c) — explicit
         grant here since not every Procurement user also holds
         Supplier_Compliance_Access (confirmed live: Prashant Singh has only
         this permission set), and this org requires explicit FLS/object
         grants beyond what admin testing reveals — see the classAccesses
         note above this same file. -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.AI_Confidence__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Evaluation_DateTime__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Reason_Code__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Reason_Detail__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Severity__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Document_Link__c.Valid_Until__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Procurement Workspace Access</label>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Policy_Document__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <!-- Compliance_Document_Link__c, Compliance_Assessment__c, and Account
         objectPermissions blocks intentionally NOT packaged.
         Compliance_Assessment__c is Master-Detail to the STANDARD Account
         object; 2GP package version validation rejects the whole package
         if any PermissionSet grants object/field permissions on a custom
         object with a Master-Detail relationship to a standard object
         (confirmed error: "references Compliance Assessment that has M-D
         relationship with Account"). Compliance_Document_Link__c's own
         Read grant transitively depends on Compliance_Assessment__c's Read
         (confirmed via dry-run), so it has to come out too. This is a hard
         platform packaging rule — access to all three must come from the
         subscriber's Profile post-install, not a packaged PermissionSet.
         Field-level grants above (fieldPermissions) are unaffected and
         still packaged normally — only object-level grants hit this rule. -->
    <tabSettings>
        <tab>Audit_Log__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Intelligence_Dashboard</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Policy_Documents</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Compliance_Console1</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>standard-Account</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
